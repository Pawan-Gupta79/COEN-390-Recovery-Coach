<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.OverviewFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Overview" />

    <LinearLayout
        android:id="@+id/stats_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:id="@+id/last_3_sessions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last 3 Sessions"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:id="@+id/avg_hr_3_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg HR: " />

            <TextView
                android:id="@+id/avg_duration_3_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg Duration: " />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/last_5_sessions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last 5 Sessions"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:id="@+id/avg_hr_5_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg HR: " />

            <TextView
                android:id="@+id/avg_duration_5_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg Duration: " />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/last_10_sessions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last 10 Sessions"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:id="@+id/avg_hr_10_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg HR: " />

            <TextView
                android:id="@+id/avg_duration_10_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg Duration: " />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stats_container">

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>