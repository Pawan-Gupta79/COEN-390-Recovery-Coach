<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Status + HR -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Disconnected"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvHeartRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- bpm"
            android:textSize="32sp"
            android:layout_marginBottom="16dp" />

        <!-- Temperature + Humidity -->
        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- °C"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- %"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Steps -->
        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steps: --"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Scan + connect controls -->
        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Scan"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect / Reconnect"
            android:layout_marginBottom="16dp" />

        <!-- Sampling controls -->
        <Button
            android:id="@+id/btnStartSampling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Sampling"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopSampling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Sampling"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <!-- Workout page navigation -->
        <Button
            android:id="@+id/btnOpenWorkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Workout Page" />

    </LinearLayout>
</ScrollView>
